# Public browser configuration. The anon key is protected by RLS and may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-real-publishable-or-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# Optional server-only adapters. Never prefix secrets with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=server-only-required-for-cron-and-never-used-by-the-browser
# AI_PROVIDER=mock
# AI_API_KEY=server-only
# EMAIL_PROVIDER=disabled
# EMAIL_API_KEY=server-only

# Korean credit-card catalog. Provider IDs are public configuration; credentials remain server-only.
CARD_CATALOG_PROVIDER=coocon
NEXT_PUBLIC_CARD_CATALOG_PROVIDER=coocon
COOCON_API_BASE_URL=
COOCON_API_KEY=
COOCON_CLIENT_ID=
COOCON_CLIENT_SECRET=

# A service key alone is insufficient: select a licensed data.go.kr dataset and install its documented field contract.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_DATASET_NAME=

# Protect scheduled full sync. Generate at least 32 random characters and send it as x-cardwise-cron-secret.
CARDWISE_CRON_SECRET=

# One-time admin bootstrap. Remove immediately after `npm run bootstrap:admin -- --confirm` succeeds.
CARDWISE_BOOTSTRAP_ADMIN_USER_ID=

# Dedicated, disposable non-admin accounts for the explicitly confirmed RLS write test.
CARDWISE_RLS_TEST_USER_A_EMAIL=
CARDWISE_RLS_TEST_USER_A_PASSWORD=
CARDWISE_RLS_TEST_USER_B_EMAIL=
CARDWISE_RLS_TEST_USER_B_PASSWORD=
