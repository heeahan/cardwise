# Public browser configuration. The anon key is protected by RLS and may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-only adapters. Never prefix secrets with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=server-only-and-not-used-by-the-browser
# AI_PROVIDER=mock
# AI_API_KEY=server-only
# EMAIL_PROVIDER=disabled
# EMAIL_API_KEY=server-only
